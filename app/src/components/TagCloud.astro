---
export interface Props {
  tags: {slug: string; label: string; count: number}[]
  linkPrefix?: string
}
const {tags, linkPrefix = '/tags'} = Astro.props
const sorted = [...tags].sort((a, b) => b.count - a.count)
const maxCount = sorted.length > 0 ? sorted[0].count : 1
---

<div class="flex flex-wrap gap-2">
  {sorted.map(({slug, label, count}) => {
    const size = 0.75 + (count / maxCount) * 0.5
    return (
      <a
        href={`${linkPrefix}/${slug}`}
        class="rounded bg-stone-100 px-2 py-1 text-stone-600 transition hover:bg-blue-100 hover:text-blue-700"
        style={`font-size: ${size}rem`}
      >
        {label}
        <span class="ml-1 text-stone-400">({count})</span>
      </a>
    )
  })}
</div>
