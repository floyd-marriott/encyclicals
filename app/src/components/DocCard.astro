---
export interface Props {
  incipit: string
  slug: string
  popeSlug: string
  year?: number | null
  documentKind?: string | null
  tags?: {slug: string; label: string}[] | null
  englishTitle?: string | null
  summaryExcerpt?: string | null
}
const {incipit, slug, popeSlug, year, documentKind, tags, englishTitle, summaryExcerpt} =
  Astro.props
---

<a
  href={`/documents/${popeSlug}/${slug}`}
  class="block rounded-lg border border-stone-200 bg-white p-4 transition hover:border-stone-400 hover:shadow-sm"
>
  <div class="font-medium text-stone-900">{incipit}</div>
  {englishTitle && englishTitle !== incipit && (
    <div class="mt-0.5 text-sm text-stone-500">{englishTitle}</div>
  )}
  {summaryExcerpt && (
    <p class="mt-2 line-clamp-2 text-sm text-stone-600">{summaryExcerpt}</p>
  )}
  <div class="mt-2 flex flex-wrap items-center gap-2 text-xs text-stone-400">
    {year && <span>{year}</span>}
    {documentKind && (
      <span class="rounded bg-stone-100 px-1.5 py-0.5 text-stone-500">{documentKind.replace(/-/g, ' ')}</span>
    )}
    {tags?.slice(0, 3).map((t) => (
      <span class="rounded bg-blue-50 px-1.5 py-0.5 text-blue-600">{t.label}</span>
    ))}
  </div>
</a>
