---
import {marked} from 'marked'

export interface Props {
  content: string
}
const {content} = Astro.props
const html = content ? await marked(content) : ''
---

<article class="prose prose-stone max-w-none prose-headings:font-semibold prose-a:text-blue-600 prose-a:no-underline hover:prose-a:underline">
  <fragment set:html={html} />
</article>
