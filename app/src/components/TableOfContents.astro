---
import type {Heading} from '../lib/markdown'

export interface Props {
  headings: Heading[]
}
const {headings} = Astro.props
---

{
  headings.length > 0 && (
    <nav class="mb-8 rounded-lg border border-stone-200 bg-stone-50 p-4">
      <h2 class="mb-2 text-xs font-semibold uppercase tracking-wide text-stone-500">Contents</h2>
      <ul class="space-y-1">
        {headings.map(h => (
          <li class={h.level === 3 ? 'ml-4' : ''}>
            <a
              href={`#${h.id}`}
              class="text-sm text-stone-600 transition hover:text-blue-600 hover:underline"
            >
              {h.text}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  )
}
