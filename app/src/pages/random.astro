---
import {client} from '../lib/sanity'

export const prerender = false

const total: number = await client.fetch('count(*[_type == "encyclical"])')
const idx = Math.floor(Math.random() * total)
const doc: {slug: string; pope: string} | null = await client.fetch(
  '*[_type == "encyclical"][$idx] {slug, "pope": pope->slug}',
  {idx},
)

if (doc) {
  return Astro.redirect(`/documents/${doc.pope}/${doc.slug}`, 302)
}
---

<p class="text-stone-500">No documents found.</p>
