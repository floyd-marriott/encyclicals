---
import BaseLayout from '../layouts/BaseLayout.astro'
import TimelineItem from '../components/TimelineItem.astro'
import {client} from '../lib/sanity'

const docs: any[] = await client.fetch(
  '*[_type == "encyclical"] | order(year asc) {incipit, slug, year, "pope": pope->{fullName, slug}}',
)

let lastYear: number | null = null
---

<BaseLayout title="Timeline">
  <h1 class="mb-6 text-2xl font-bold text-stone-900">Timeline</h1>
  <p class="mb-8 text-sm text-stone-500">
    All 401 documents in chronological order
  </p>
  <div class="border-l-2 border-stone-200 pl-4">
    {docs.map(d => {
      const isFirst = d.year !== lastYear
      lastYear = d.year
      return <TimelineItem {...d} isFirstInYear={isFirst} />
    })}
  </div>
</BaseLayout>
