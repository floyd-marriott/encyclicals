---
import BaseLayout from '../layouts/BaseLayout.astro'
import PopeCard from '../components/PopeCard.astro'
import CenturyStrip from '../components/CenturyStrip.astro'
import TagCloud from '../components/TagCloud.astro'
import SearchInput from '../components/SearchInput.astro'
import {client} from '../lib/sanity'

const popes: any[] = await client.fetch('*[_type == "pope"] | order(fullName asc) {slug, fullName, documentCount}')
const recent: any[] = await client.fetch('*[_type == "encyclical"] | order(year desc)[0..4] {incipit, slug, year, "pope": pope->{fullName, slug}}')
const tagData: {tags: string[]}[] = await client.fetch('*[_type == "encyclical"] {tags}')

const tagCounts: Record<string, number> = {}
for (const {tags} of tagData) {
  for (const t of tags || []) {
    tagCounts[t] = (tagCounts[t] || 0) + 1
  }
}
---

<BaseLayout title="Encyclicals">
  <div class="space-y-12">
    <section class="text-center space-y-4">
      <h1 class="text-3xl font-bold tracking-tight text-stone-900">Papal Encyclicals</h1>
      <p class="text-stone-500">401 documents from 43 popes spanning 8 centuries</p>
      <div class="mx-auto max-w-md">
        <SearchInput />
      </div>
      <a
        href="/random"
        class="inline-block rounded-lg border border-stone-300 bg-white px-4 py-2 text-sm text-stone-600 transition hover:border-blue-400 hover:text-blue-600"
      >
        Surprise Me
      </a>
    </section>

    <section>
      <h2 class="mb-4 text-lg font-semibold text-stone-900">Browse by Century</h2>
      <CenturyStrip />
    </section>

    <section>
      <div class="mb-4 flex items-baseline justify-between">
        <h2 class="text-lg font-semibold text-stone-900">Popes</h2>
        <a href="/popes" class="text-sm text-blue-600 hover:underline">View all</a>
      </div>
      <div class="grid grid-cols-2 gap-3 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6">
        {popes.map(p => <PopeCard slug={p.slug} fullName={p.fullName} documentCount={p.documentCount} />)}
      </div>
    </section>

    <section>
      <div class="mb-4 flex items-baseline justify-between">
        <h2 class="text-lg font-semibold text-stone-900">Tags</h2>
        <a href="/tags" class="text-sm text-blue-600 hover:underline">View all</a>
      </div>
      <TagCloud tags={tagCounts} />
    </section>

    <section>
      <h2 class="mb-4 text-lg font-semibold text-stone-900">Recent Documents</h2>
      <div class="space-y-2">
        {recent.map(d => (
          <a
            href={`/documents/${d.pope.slug}/${d.slug}`}
            class="block rounded-lg border border-stone-200 bg-white p-3 text-sm transition hover:border-stone-400 hover:shadow-sm"
          >
            <span class="text-stone-400">{d.year}</span>
            {' — '}
            <span class="font-medium text-stone-900">{d.incipit}</span>
            <span class="text-stone-400"> ({d.pope.fullName})</span>
          </a>
        ))}
      </div>
    </section>
  </div>
</BaseLayout>
